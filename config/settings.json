{
  "theme": "pi-coder-1337",
  "defaultThinkingLevel": "xhigh",
  "compaction": {
    "enabled": true,
    "reserveTokens": 52429,
    "keepRecentTokens": 20000
  },
  "npmCommand": [
    "pnpm",
    "--config.node-linker=hoisted"
  ],
  "extensions": ["-builtin:codemode", "-builtin:tool-search"],
  "defaultTools": ["read", "bash", "edit", "write", "grep", "glob", "find", "ls", "codemode", "tool_search"],
  "tuiMode": "regular",
  "showHardwareCursor": true,
  "packages": [
    {
      "source": "npm:pi-web-access",
      "extensions": []
    },
    "npm:pi-subagents",
    "git:github.com/jayli/superpowers"
  ],
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "doubleEscapeAction": "none",
  "subagents": {
    "defaultModel": "inherit",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit"
      ]
    },
    "watchdog": {
      "enabled": false
    },
    "agentOverrides": {
      "researcher": {
        "tools": [
          "read",
          "write",
          "pi_web_search",
          "fetch_content",
          "get_search_content",
          "source_check"
        ]
      },
      "delegate": {
        "tools": "inherit"
      },
      "worker": {
        "tools": "inherit"
      },
      "reviewer": {
        "inheritProjectContext": false,
        "tools": ["read", "grep", "glob", "find", "ls", "watchdog_diff", "contact_supervisor"]
      },
      "scout": {
        "tools": ["read", "grep", "glob", "find", "ls", "bash", "write", "contact_supervisor"]
      }
    }
  }
}
